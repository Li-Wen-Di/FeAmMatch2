$HistoryLength=0;
root=DirectoryName[$InputFileName,3];
Get[FileNameJoin[{root,"src","wolfram","FeAmMatch2.wl"}]];
example=Environment["FM2_EXAMPLE_DIR"];
out=Environment["FM2_OUTPUT"];
configPath=Environment["FM2_TOOLCHAIN"];
config=If[StringQ[configPath],Import[configPath,"RawJSON"],<||>];
If[!AssociationQ[config],Print["Invalid toolchain configuration: ",configPath];Exit[2]];
request=Import[FileNameJoin[{example,"input","request.json"}],"RawJSON"];
task=CreateMatchingTask[FileNameJoin[{example,"input","UV.fr"}],FileNameJoin[{example,"input","EFTGreen.fr"}],request];
If[FailureQ[task],Print[InputForm[task]];Exit[1]];
plan=PlanMatching[task];
If[FailureQ[plan],Print[InputForm[plan]];Exit[1]];
Print["Planned ",Length[plan["tasks"]]," tasks. Output: ",out];
result=RunMatching[task,out,config];
If[FailureQ[result],Print[InputForm[result]];Exit[1]];
Put[result,FileNameJoin[{out,"result.wl"}]];
Print["Completed: ",out];
Exit[0];
