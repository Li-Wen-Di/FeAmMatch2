(* Exact algebra and same-run FORM reuse contracts. No matching reference import. *)
$HistoryLength=0;root=Environment["FM2_ROOT"];out=Environment["FM2_OUTPUT"];
Get[root<>"/src/wolfram/FeAmMatch2.wl"];If[!DirectoryQ[out],CreateDirectory[out,CreateIntermediateDirectories->True]];
checks=<||>;check[n_,x_]:=(AssociateTo[checks,n->TrueQ[x]];Print[n," : ",checks[n]]);
oldCut[x_,s_,n_]:=Expand[Normal[Series[x,{s,0,n}]]/.s->1];
cut=FeAmMatch2`Private`scaledPolynomialCut;
check["polynomial_projection_exact",And@@Flatten[Table[Expand[cut[(1+u s+v s^2)^j,s,n]-oldCut[(1+u s+v s^2)^j,s,n]]===0,{j,0,7},{n,0,8}]]];
check["negative_polynomial_budget_is_empty",cut[1+s+s^2,s,-1]===0];
check["rational_series_fallback",Expand[cut[1/(1-s),s,5]-oldCut[1/(1-s),s,5]]===0];
check["Laurent_series_fallback",Expand[cut[s^-2+3+s^4,s,2]-oldCut[s^-2+3+s^4,s,2]]===0];
check["epsilon_coefficients_exact",cut[(1+s+2s^3)/(ep^2(1-ep)),s,1]===2/(ep^2(1-ep))];
mu=Unique["testLorentz"];nu=Unique["testLorentz"];
fields={bigH,lightA,lightB};rules={bigH->lightA^2/MM+lightB^3/MM^2+ScalarJet[lightA,{mu,mu}]/MM^2,lightA->lightA,lightB->lightB};
action=bigH^4+bigH^2 lightB^2+ScalarJet[bigH,{nu}]^2;
full=SubstituteScalarFields[action,rules,fields];
canon[x_]:=FeAmMatch2`Private`scalarActionTheory[<|"FieldSymbols"->fields|>,x]["Lagrangian"];
check["bounded_substitution_all_dimensions",And@@Table[Expand[canon[SubstituteScalarFields[action,rules,fields,n]]-canon[FeAmMatch2`Private`scalarJetDimensionTruncate[full,fields,n]]]===0,{n,0,10}]];
check["three_argument_substitution_untruncated",!FreeQ[full,lightA^8]];
check["derivative_cannot_restore_discarded_dimension",SubstituteScalarFields[ScalarJet[bigH,{mu,mu}],{bigH->lightA^5},fields,6]===0];
cfg=FeAmMatch2`Private`resolveToolchain[Import[Environment["FM2_TOOLCHAIN"],"RawJSON"]];cfg=Join[cfg,<|"WorkingDirectory"->out<>"/form","RetainAssetCopies"->False|>];
Block[{FeAmMatch2`Private`$formTaskCache=<||>,FeAmMatch2`Private`$formExecutionStats=<|"Executed"->0,"Hits"->0,"ExecutionSeconds"->0.|>},
 a=FeAmMatch2`Private`reduceTadpoleFORM[5,MM,cfg];b=FeAmMatch2`Private`reduceTadpoleFORM[5,NN,cfg];
 If[FailureQ[a]||FailureQ[b],Print[{a,b}//FullForm];Exit[1]];
 check["reuse_same_encoded_integral_with_distinct_alias",Expand[(a["Expression"]/.MM->NN)-b["Expression"]]===0&&Lookup[b["Job"],"Cache",None]==="same_run_verified_hit"];
 check["exact_D_recurrence",Factor[a["Expression"]-((1-D/2)(2-D/2)(3-D/2)(4-D/2)/(24 MM^8))VacuumIntegral[1,MM]]===0];
 c=FeAmMatch2`Private`reduceTadpoleFORM[5,MM,Join[cfg,<|"ReuseFORMTasks"->False|>]];
 check["reuse_can_be_disabled",a["Expression"]===c["Expression"]&&!KeyExistsQ[c["Job"],"Cache"]];
 Export[a["Job"]["directory"]<>"/result.out","0","Text"];
 d=FeAmMatch2`Private`reduceTadpoleFORM[5,MM,cfg];
 check["corrupt_cached_output_reexecuted",d["Expression"]===c["Expression"]&&!KeyExistsQ[d["Job"],"Cache"]];
 hdr=out<>"/sunset-local.h";CopyFile[cfg["SunsetHeader"],hdr];
 cfg2=Join[cfg,<|"SunsetHeader"->hdr|>];
 e1=FeAmMatch2`Private`reduceTadpoleFORM[5,MM,cfg2];
 str=OpenAppend[hdr];WriteString[str,"\n* cache invalidation probe\n"];Close[str];
 e2=FeAmMatch2`Private`reduceTadpoleFORM[5,MM,cfg2];
 check["changed_header_reexecuted",e1["Expression"]===e2["Expression"]&&e1["Job"]["directory"]=!=e2["Job"]["directory"]&&!KeyExistsQ[e2["Job"],"Cache"]];
 check["cache_records_only_current_execution",FeAmMatch2`Private`$formExecutionStats["Hits"]===1&&FeAmMatch2`Private`$formExecutionStats["Executed"]===5];
];
check["cache_scope_exits_with_run",!AssociationQ[FeAmMatch2`Private`$formTaskCache]];
Export[out<>"/report.json",<|"passed"->And@@Values[checks],"checks"->checks,"scope"->"Exact polynomial/series projection, bounded differentiated multi-field substitution, exact-D FORM recurrence and same-run cache integrity/invalidation; full two-loop coefficients checked separately."|>,"RawJSON"];
Exit[If[And@@Values[checks],0,1]];
