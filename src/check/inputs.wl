$HistoryLength=0;
root=Environment["FM2_ROOT"];out=Environment["FM2_OUTPUT"];
Get[root<>"/src/wolfram/FeAmMatch2.wl"];
If[!DirectoryQ[out],CreateDirectory[out,CreateIntermediateDirectories->True]];
checks=<||>;details=<||>;
record[name_,condition_,detail_:Null]:=(AssociateTo[checks,name->TrueQ[condition]];AssociateTo[details,name->ToString[detail,InputForm]];Print[name," : ",TrueQ[condition]]);
eft=LoadEFTModel[root<>"/example/example1/input/EFTGreen.fr"];
record["independent_eft_fr_loaded",AssociationQ[eft],eft];
If[FailureQ[eft],Export[out<>"/report.json",<|"passed"->False,"checks"->checks,"details"->details|>,"RawJSON"];Exit[1]];
record["no_alpha_name_requirement",AllTrue[eft["WilsonCoefficients"],!StringContainsQ[SymbolName[#],"alpha"]&]];
record["coefficient_dimensions_inferred",Lookup[eft["Parameters"]/@eft["WilsonCoefficients"],"Dimension"]==={2,0,-2,0,-2,-2}];
Do[uv=LoadUVModel[root<>"/example/"<>name<>"/input/UV.fr"];
 record[name<>"_independent_uv_fr_loaded",AssociationQ[uv],uv];
 task=CreateMatchingTask[uv,eft,<|"Loops"->2,"MaxDimension"->6|>];
 record[name<>"_dual_input_task",AssociationQ[task]&&task["Stage"]==="input_frozen",task];
 record[name<>"_isolated_field_contexts",AssociationQ[task]&&First[task["LightFieldMap"]][[1]]=!=First[task["LightFieldMap"]][[2]]],{name,{"example1","example2"}}];
response=BuildOperatorResponses[eft];
record["automatic_six_coefficient_rank",AssociationQ[response]&&response["Rank"]===Length[eft["WilsonCoefficients"]],response];
record["matrix_derived_not_fixed",AssociationQ[response]&&Length[response["Rows"]]>0&&Length[response["Channels"]]===3];
record["exact_overdetermined_solver",AssociationQ[SolveExactSystem[{{1,1},{1,-1},{2,0}},{3,1,4},{x,y}]]];
record["unused_inconsistent_equation_rejected",FailureQ[SolveExactSystem[{{1,1},{1,-1},{2,0}},{3,1,5},{x,y}]]];
record["rank_deficiency_rejected",FailureQ[SolveExactSystem[{{1,1},{2,2}},{3,6},{x,y}]]];
uv=LoadUVModel[root<>"/example/example1/input/UV.fr"];light=SelectFirst[uv["Fields"],#["Role"]==="light"&]["Symbol"];
record["explicit_Z2_checked",AssociationQ[LoadUVModel[Join[uv,<|"Symmetries"->{<|"Type"->"Z2","Charges"-><|light->-1|>|>}|>]]]];
heavy=SelectFirst[uv["Fields"],#["Role"]==="heavy"&]["Symbol"];
record["violated_Z2_rejected",FailureQ[LoadUVModel[Join[uv,<|"Symmetries"->{<|"Type"->"Z2","Charges"-><|heavy->-1|>|>}|>]]]];
record["unimplemented_group_rejected",FailureQ[LoadUVModel[Join[uv,<|"Symmetries"->{<|"Type"->"O(N)","Charges"-><||>|>}|>]]]];
record["implicit_multiplicity_rejected",FailureQ[LoadUVModel[Join[uv,<|"Fields"->ReplacePart[uv["Fields"],1->Join[First[uv["Fields"]],<|"Multiplicity"->2|>]]|>]]]];
record["unsupported_dimension_rejected",FailureQ[CreateMatchingTask[uv,eft,<|"MaxDimension"->8|>]]];
If[AssociationQ[response],Put[response,out<>"/response.wl"]];
report=<|"passed"->And@@Values[checks],"checks"->checks,"details"->details|>;
Export[out<>"/report.json",report,"RawJSON"];Print["SUMMARY ",Count[Values[checks],True],"/",Length[checks]];
Exit[If[report["passed"],0,1]];
