(* Algebraic guard checks and a small local Hessian A/B computation. *)
$HistoryLength=0;
root=Environment["FM2_ROOT"];If[!StringQ[root],root=DirectoryName[DirectoryName[DirectoryName[$InputFileName]]]];
out=Environment["FM2_OUTPUT"];If[!StringQ[out]||out==="",Print["Set FM2_OUTPUT to a new validation directory."];Exit[2]];
Get[root<>"/src/wolfram/FeAmMatch2.wl"];Get[root<>"/src/check/support/LocalOneLoopPoles.wl"];
If[!DirectoryQ[out],CreateDirectory[out,CreateIntermediateDirectories->True]];
cfg=FeAmMatch2`Private`resolveToolchain[Import[Environment["FM2_TOOLCHAIN"],"RawJSON"]];
checks=<||>;check[name_,condition_]:=(AssociateTo[checks,name->TrueQ[condition]];Print[name," : ",checks[name]]);
e=FeAmMatch2`Model`eps;q=FeAmMatch2`Model`q1;p=FeAmMatch2`Model`p1;
cv[x_,n_]:=FeAmMatch2`Private`localPoleUVConvergentQ[x,q,{q,p},n,e];
check["strictly_convergent_rank_bound",cv[SP[q+p,q+p],4]];
check["log_divergent_term_kept",!cv[SP[q,q]^2,4]];
check["power_divergent_term_kept",!cv[SP[q,q]^2,3]];
check["explicit_regulator_pole_kept",!cv[1/e,3]];
check["unknown_rank_kept",!cv[1/SP[q,q],4]];
theory=<|"Fields"->{<|"Role"->"heavy","Mass"->bigM|>}|>;
base={<|"Response"->g|>};wc=<|"HardLightWeights"-><|smallM->1|>,"HardWeightBudget"->0|>;
skip[s_,v_,config_]:=TrueQ[FeAmMatch2`Private`hardSourceWeightDecision[s,v,theory,<||>,config]["Skip"]];
check["positive_source_weight_skipped",skip[smallM^2/bigM^2,base,wc]];
check["boundary_weight_kept",!skip[smallM^2/bigM^2,base,Join[wc,<|"HardWeightBudget"->2|>]]];
check["negative_vertex_weight_kept",!skip[smallM^2/bigM^2,{<|"Response"->g/smallM|>},wc]];
check["unknown_source_weight_kept",!skip[Log[smallM],base,wc]];
check["unknown_budget_kept",!skip[smallM^2/bigM^2,base,KeyDrop[wc,{"HardWeightBudget"}]]];
check["weighted_heavy_mass_kept",!skip[smallM^2/bigM^2,base,Join[wc,<|"HardLightWeights"-><|smallM->1,bigM->1|>|>]]];
check["source_pruning_can_be_disabled",!skip[smallM^2/bigM^2,base,Join[wc,<|"PruneHardSourceWeights"->False|>]]];
odd=CreateMatchingTask[root<>"/src/check/fixtures/odd-legs/UV.wl",root<>"/src/check/fixtures/odd-legs/EFTGreen.wl",<|"Loops"->1|>];
eft=odd["EFT"];mass=First[Select[odd["UV"]["Fields"],#["Role"]==="light"&]]["Mass"];
rules=Table[c->Switch[SymbolName[c],"z",1,"c2",mass^2,"c3",oddA,"c4",oddB,_,0],{c,eft["WilsonCoefficients"]}];
procs=Select[PlanMatching[odd]["tasks"],#["loops"]===1&];
dirs=Table[c->Symbol["FM2OptTest`"<>SymbolName[c]],{c,eft["WilsonCoefficients"]}];
a=ComputeLocalOneLoopPoles[odd,eft,rules,procs,out<>"/optimized",Join[cfg,<|"PoleDirections"->dirs|>]];
b=ComputeLocalOneLoopPoles[odd,eft,rules,procs,out<>"/unoptimized",Join[cfg,<|"PoleDirections"->dirs,"OptimizeLocalPoles"->False,"LocalPoleAudit"->"Embedded"|>]];
If[FailureQ[a]||FailureQ[b],Print[{a,b}//FullForm];Exit[1]];
res=Factor/@Flatten[Table[{a["Channels"][k]["Expression"]-b["Channels"][k]["Expression"],a["DirectionChannels"][k]["Expression"]-b["DirectionChannels"][k]["Expression"]},{k,Keys[a["Channels"]]}]];
check["optimized_vs_unoptimized_all_odd_channels",AllTrue[res,#===0&]];
check["audit_records_external_by_default",!KeyExistsQ[a,"Records"]&&Length[a["AuditRecords"]]===Length[procs]];
check["external_audit_hashes_valid",AllTrue[a["AuditRecords"],FileExistsQ[#["Path"]]&&FeAmMatch2`Private`toolHash[#["Path"]]===#["SHA256"]&]];
check["embedded_audit_opt_in",KeyExistsQ[b,"Records"]&&Length[b["Records"]]===Length[procs]];
check["convergent_pruning_exercised",a["Optimization"]["UVConvergentTermsSkipped"]>0];
check["early_zero_momenta_exercised",AnyTrue[a["Optimization"]["Channels"],TrueQ[#["EarlyZeroExternalMomenta"]]&]];
bad=ComputeLocalOneLoopPoles[odd,eft,rules,procs,out<>"/invalid",Join[cfg,<|"LocalPoleAudit"->"invalid"|>]];
check["unknown_audit_mode_fails",FailureQ[bad]&&First[bad]==="LocalPoleAudit"];
statJSON[s_]:=Join[KeyDrop[s,{"Channels"}],<|"Channels"->(Join[#,<|"Channel"->ToString[#["Channel"],InputForm]|>]&/@s["Channels"])|>];
Export[out<>"/report.json",<|"passed"->And@@Values[checks],"checks"->checks,"optimized_statistics"->statJSON[a["Optimization"]],"unoptimized_statistics"->statJSON[b["Optimization"]],"residuals"->(ToString[#,InputForm]&/@res),"scope"->"Conservative guard cases and fresh optimized/unoptimized odd scalar local base and all independent directions; not a full two-loop run."|>,"RawJSON"];
Exit[If[And@@Values[checks],0,1]];
