$HistoryLength=0;root=Environment["FM2_ROOT"];out=Environment["FM2_OUTPUT"];
Get[root<>"/src/wolfram/FeAmMatch2.wl"];
If[!DirectoryQ[out],CreateDirectory[out,CreateIntermediateDirectories->True]];
eft=LoadEFTModel[root<>"/example/example1/input/EFTGreen.fr"];
uv=LoadUVModel[root<>"/example/example1/input/UV.fr"];
task=CreateMatchingTask[uv,eft,<|"Loops"->2,"MaxDimension"->6|>];plan=PlanMatching[task];Put[plan,out<>"/plan.wl"];
checks=<||>;record[n_,c_]:=(AssociateTo[checks,n->TrueQ[c]];Print[n," : ",TrueQ[c]]);
record["dual_plan_dispatch",AssociationQ[plan]&&plan["Schema"]==="feammatch2.matching-plan.v2"];
record["all_requested_loop_orders",Sort[DeleteDuplicates[Lookup[plan["tasks"],"loops"]]]==={0,1,2}];
record["vertex_counts_from_actual_action",And@@Flatten[Table[Total[c["Counts"]*(Length/@c["Vertices"]-2)]===2t["loops"]+t["legs"]-2,{t,plan["tasks"]},{c,t["vertex_combinations"]}]]];
record["multiple_vertex_orders_covered",AnyTrue[plan["tasks"],Length[#["generator_vertex_orders"]]>1&]];
record["no_channel_name_dispatch",AllTrue[plan["tasks"],StringStartsQ[#["id"],"channel-"]&]];
record["auxiliary_precision_budgeted",AllTrue[Select[plan["tasks"],#["loops"]===1&],#["taylor_order"]>=#["momentum_order"]+2&]];
response=plan["Response"];
coeffs=eft["WilsonCoefficients"];renamed=Table[Unique["arbitraryCoefficient"],Length[coeffs]];
eft2=LoadEFTModel[Join[KeyDrop[eft,{"Terms","Identity","FieldSymbols"}],<|"Name"->"NoBenchmarkName","Lagrangian"->(eft["Lagrangian"]/.Thread[coeffs->renamed]),"WilsonCoefficients"->renamed,"Parameters"->KeyMap[Replace[#,Thread[coeffs->renamed]]&,eft["Parameters"]]|>]];
record["renamed_coefficients_supported",AssociationQ[eft2]&&BuildOperatorResponses[eft2]["Rank"]===Length[renamed]];
duplicate=Unique["duplicateCoefficient"];
eft3=LoadEFTModel[Join[KeyDrop[eft,{"Terms","Identity","FieldSymbols"}],<|"Lagrangian"->(eft["Lagrangian"]-duplicate*First[eft["FieldSymbols"]]^6),"WilsonCoefficients"->Append[coeffs,duplicate],"Parameters"->Join[eft["Parameters"],<|duplicate-><|"Dimension"->-2,"Value"->1|>|>]|>]];
record["dependent_operator_reported",AssociationQ[eft3]&&!CheckLinearDependence[eft3]["Independent"]];
record["dependent_basis_stops_planning",FailureQ[PlanMatching[CreateMatchingTask[uv,eft3,<||>]]]];
Export[out<>"/report.json",<|"passed"->And@@Values[checks],"checks"->checks|>,"RawJSON"];Exit[If[And@@Values[checks],0,1]];
