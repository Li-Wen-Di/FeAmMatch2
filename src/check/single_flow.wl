$HistoryLength=0;root=Environment["FM2_ROOT"];out=Environment["FM2_OUTPUT"];
Get[root<>"/src/wolfram/FeAmMatch2.wl"];cfg=FeAmMatch2`CheckToolchain[Import[Environment["FM2_TOOLCHAIN"],"RawJSON"],"Probe"->False]["config"];
If[!DirectoryQ[out],CreateDirectory[out,CreateIntermediateDirectories->True]];
checks=<||>;record[n_,c_]:=(AssociateTo[checks,n->TrueQ[c]];Print[n," : ",TrueQ[c]]);
task=CreateMatchingTask[root<>"/example/example1/input/UV.fr",root<>"/example/example1/input/EFTGreen.fr",<|"Loops"->1|>];
record["single_request_has_no_backend_selector",AssociationQ[task]&&!KeyExistsQ[task["Request"],"MatchingBackend"]];
retired={"LoadScalarModel","ScalarTreeMatch","CanonicalizeScalar","MatchScalarOneLoop","AssembleScalarTwoLoop","ExportScalarUFO","GenerateScalarTask","BuildAuxiliaryEFT8","IntegrateAmplitudeSet"};
record["retired_public_symbols_absent",AllTrue[retired,Names["FeAmMatch2`"<>#]==={}&]];
record["preset_model_entry_rejected",FailureQ[RunMatching["old-model.json",out<>"/preset",cfg]]];
bad=CreateMatchingTask[task["UV"],task["EFT"],<|"MatchingBackend"->"ExplicitEFTAudit"|>];record["removed_backend_request_rejected",FailureQ[bad]&&First[bad]==="RequestKeys"];
bad=CreateMatchingTask[task["UV"],task["EFT"],<|"UnknownOption"->True|>];record["unknown_request_not_silently_ignored",FailureQ[bad]&&First[bad]==="RequestKeys"];
oldCall=ComputeTheoryAmplitudes[task,"EFT",1,out<>"/eft",cfg];record["removed_EFT_graph_signature_has_no_implementation",Head[oldCall]===ComputeTheoryAmplitudes&&!DirectoryQ[out<>"/eft"]];
odd=CreateMatchingTask[root<>"/src/check/fixtures/odd-legs/UV.wl",root<>"/src/check/fixtures/odd-legs/EFTGreen.wl",<|"Loops"->1|>];
eft=odd["EFT"];f=First[eft["FieldSymbols"]];mass=First[Select[odd["UV"]["Fields"],#["Role"]==="light"&]]["Mass"];
rules=Table[c->Switch[SymbolName[c],"z",1,"c2",mass^2,"c3",oddA,"c4",oddB,_,0],{c,eft["WilsonCoefficients"]}];
procs=Select[PlanMatching[odd]["tasks"],#["loops"]===1&];
r=FeAmMatch2`Private`diagramEFTCounterterms[odd,eft,rules,procs,out<>"/odd",Join[cfg,<|"MaxCouplingWeight"->2|>]];If[FailureQ[r],Print[r//FullForm];Exit[1]];
v=-((eft["Lagrangian"]/.rules)/.ScalarJet[_,_]->0);e=FeAmMatch2`Model`eps;
expected=FeAmMatch2`Private`actionTheoryChannels[eft,D[v,{f,2}]^2/(4e),r["Channels"]];
res=Factor/@Table[r["Channels"][k]["Expression"]-expected[k]["Expression"],{k,Keys[expected]}];
record["odd_background_explicit_diagram_poles",AllTrue[res,#===0&]];
badRules=rules/.Rule[c_,1]/;SymbolName[c]==="z":>Rule[c,2];
bad=FeAmMatch2`Private`diagramEFTCounterterms[odd,eft,badRules,procs,out<>"/bad-kernel",cfg];record["noncanonical_reference_kernel_rejected",FailureQ[bad]&&First[bad]==="LocalPoleFreeKernel"];
Export[out<>"/report.json",<|"passed"->And@@Values[checks],"checks"->checks,"scope"->"Single public workflow, removed interfaces/selector, and independent odd local poles; no complete odd two-loop claim."|>,"RawJSON"];
Exit[If[And@@Values[checks],0,1]];
